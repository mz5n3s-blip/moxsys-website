{
  "name": "墨枢科技 Moxsys",
  "version": "1.0.0",
  "description": "企业级智能操作系统官网设计系统",
  
  "colors": {
    "background": {
      "dark": "#0B0C10",
      "dark-light": "#1F2833",
      "card": "rgba(31, 40, 51, 0.6)"
    },
    "primary": {
      "cyan": "#66FCF1",
      "cyan-dim": "#45A29E",
      "cyan-glow": "rgba(102, 252, 241, 0.4)"
    },
    "accent": {
      "gold": "#FFC107",
      "gold-dark": "#E5AC00",
      "gold-glow": "rgba(255, 193, 7, 0.4)"
    },
    "text": {
      "primary": "#FFFFFF",
      "secondary": "#C5C6C7",
      "muted": "#8D8E8F"
    },
    "semantic": {
      "danger": "#E74C3C",
      "warning": "#F59E0B",
      "success": "#66FCF1"
    },
    "border": {
      "default": "rgba(102, 252, 241, 0.15)",
      "hover": "rgba(102, 252, 241, 0.5)",
      "active": "#66FCF1"
    }
  },

  "typography": {
    "font-family": {
      "sans": ["PingFang SC", "思源黑体", "Noto Sans SC", "system-ui", "sans-serif"],
      "mono": ["JetBrains Mono", "SF Mono", "monospace"]
    },
    "scale": {
      "hero": { "size": "56px", "line-height": "1.1", "weight": 700, "letter-spacing": "-0.02em" },
      "h1": { "size": "48px", "line-height": "1.2", "weight": 700, "letter-spacing": "-0.02em" },
      "h2": { "size": "36px", "line-height": "1.3", "weight": 700, "letter-spacing": "-0.01em" },
      "h3": { "size": "24px", "line-height": "1.4", "weight": 600 },
      "body": { "size": "16px", "line-height": "1.6", "weight": 400 },
      "small": { "size": "14px", "line-height": "1.5", "weight": 400 },
      "caption": { "size": "12px", "line-height": "1.4", "weight": 500 }
    }
  },

  "spacing": {
    "unit": 4,
    "scale": {
      "xs": "4px",
      "sm": "8px",
      "md": "16px",
      "lg": "24px",
      "xl": "32px",
      "2xl": "48px",
      "3xl": "64px",
      "section": "96px"
    }
  },

  "border-radius": {
    "sm": "4px",
    "md": "8px",
    "lg": "12px",
    "xl": "16px",
    "full": "9999px"
  },

  "shadows": {
    "glow-cyan": "0 0 20px rgba(102, 252, 241, 0.3), 0 0 40px rgba(102, 252, 241, 0.1)",
    "glow-gold": "0 0 20px rgba(255, 193, 7, 0.4), 0 0 40px rgba(255, 193, 7, 0.2)",
    "card": "0 4px 24px rgba(0, 0, 0, 0.3)"
  },

  "animation": {
    "duration": {
      "fast": "150ms",
      "normal": "300ms",
      "slow": "500ms",
      "slower": "800ms"
    },
    "easing": {
      "ease-out": "cubic-bezier(0, 0, 0.2, 1)",
      "ease-in-out": "cubic-bezier(0.4, 0, 0.2, 1)",
      "spring": "cubic-bezier(0.34, 1.56, 0.64, 1)"
    }
  },

  "breakpoints": {
    "sm": "640px",
    "md": "768px",
    "lg": "1024px",
    "xl": "1280px",
    "2xl": "1536px"
  }
}
